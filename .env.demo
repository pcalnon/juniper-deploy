# juniper-deploy/.env.demo
# Demo profile environment — used with: docker compose --profile demo --env-file .env.demo up
#
# This file provides overrides for the demo profile. All values shown below
# match the defaults in docker-compose.yml and are included for documentation.
# Uncomment and modify any line to customize the demo environment.

# Service ports (same as production defaults)
JUNIPER_DATA_PORT=8100
CASCOR_PORT=8200
# CASCOR_HOST_PORT=8201  # Host-exposed port (default: 8201; set to 8200 if available)
CANOPY_PORT=8050

# Log levels (more verbose for demo observation)
JUNIPER_DATA_LOG_LEVEL=INFO
CASCOR_LOG_LEVEL=INFO
