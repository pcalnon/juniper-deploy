# =============================================================================
# Juniper Deploy — Observability Profile Overrides
#
# Source this file when running with the observability profile:
#   docker compose --env-file .env.observability \
#     --profile full --profile observability up -d
#
# Or use one of the Makefile shortcuts:
#   make monitor    # full + observability  (aliased as `make obs`)
#   make obs-demo   # demo + observability (scrapes juniper-{cascor,canopy}-demo
#                   # via prometheus.demo.yml; closes the POC §6 deferred
#                   # follow-up — see notes/poc/POC_REMEDIATION_PLAN_2026-05-27.md)
#
# Both targets load this same env file. The values below match the
# canonical full-profile scrape topology, and the demo-profile services
# (juniper-cascor-demo / juniper-canopy-demo) consume the same
# `JUNIPER_*_METRICS_TRUSTED_IPS` env vars so a single allowlist covers
# both flows. ``make obs-demo`` additionally exports
# ``PROMETHEUS_CONFIG_FILE=prometheus.demo.yml`` so the prometheus
# container's ``--config.file`` points at the demo-aware scrape config.
# =============================================================================

# Enable Prometheus /metrics endpoint on all services
JUNIPER_DATA_METRICS_ENABLED=true
JUNIPER_CASCOR_METRICS_ENABLED=true
CANOPY_METRICS_ENABLED=true

# SEC-F19 / D5 — network-scope metrics authorization (design: juniper-ml
# notes/JUNIPER_CANOPY_CONTROL_SURFACE_AUTH_AND_NAT_DESIGN_2026-07-03.md §5 C1;
# history: SEC-16 juniper-data#157 / §3.1 juniper-cascor#313 / §6 juniper-canopy#331,
# `MetricsAuthMiddleware` promoted to `juniper-observability` 0.3.0 in juniper-ml#335).
#
# These allowlists authorize WHICH SUBNETS may scrape ``/metrics`` on juniper-data /
# juniper-cascor / juniper-canopy via their ``MetricsAuthMiddleware`` IP allowlists.
# They are pinned to EXACTLY the compose ``ipam.config.subnet`` CIDRs of the networks
# each target SHARES with Prometheus, so Prometheus's scrape source address is always
# in-list and the 172.23-vs-172.18–21 drift that broke scraping (audit HO-3) cannot
# recur. The pinned compose subnets (docker-compose.yml networks block) are:
#   backend  172.28.0.0/16 (internal)   frontend    172.30.0.0/16
#   data     172.29.0.0/16 (internal)   monitoring  172.31.0.0/16
# Prometheus is attached to all four; the metrics targets sit on:
#   juniper-data   -> backend + data              => 172.28, 172.29
#   juniper-cascor -> backend + data + frontend   => 172.28, 172.29, 172.30
#   juniper-canopy -> backend + data + frontend   => 172.28, 172.29, 172.30
# (monitoring 172.31 hosts prometheus/grafana/alertmanager only — no scrape target
# lives there, so it is intentionally absent from every allowlist.)
#
# SCOPE, HONESTLY: this is NETWORK-SCOPE AUTHORIZATION, backed by internal:true
# isolation on backend/data plus the fail-closed MetricsAuthMiddleware (loopback-only
# default; 403 on an absent/unparseable client IP; fail-loud on a bad CIDR; IPv4-mapped
# IPv6 unwrapped before the membership check). It is NOT per-host authentication —
# Docker NAT collapses every client to the bridge gateway (SEC-F19), so a per-IP
# allowlist cannot distinguish individual hosts inside the NAT. Loopback
# (127.0.0.1, ::1) is preserved for host-local scrapes. The demo-profile targets
# (juniper-cascor-demo / juniper-canopy-demo) reuse the same env vars and share the
# same networks, so one allowlist covers both flows. The compose ipam subnets and
# these CIDRs are drift-checked by tests/test_compose_metrics_subnet_alignment.py.
JUNIPER_DATA_METRICS_TRUSTED_IPS=["172.28.0.0/16","172.29.0.0/16","127.0.0.1","::1"]
JUNIPER_CASCOR_METRICS_TRUSTED_IPS=["172.28.0.0/16","172.29.0.0/16","172.30.0.0/16","127.0.0.1","::1"]
JUNIPER_CANOPY_METRICS_TRUSTED_IPS=["172.28.0.0/16","172.29.0.0/16","172.30.0.0/16","127.0.0.1","::1"]

# Grafana admin credentials are managed via the Docker secret
# (GF_SECURITY_ADMIN_PASSWORD__FILE) populated from
# secrets/grafana_admin_password.txt. The username defaults to "admin" in
# docker-compose.yml; override GRAFANA_ADMIN_USER there if needed.
