# =============================================================================
# Juniper Deploy — Observability Profile Overrides
#
# Source this file when running with the observability profile:
#   docker compose --env-file .env --env-file .env.observability \
#     --profile full --profile observability up -d
#
# Or use the Makefile shortcut:
#   make obs        # full + observability
#   make obs-demo   # demo + observability
# =============================================================================

# Enable Prometheus /metrics endpoint on all services
JUNIPER_DATA_METRICS_ENABLED=true
JUNIPER_CASCOR_METRICS_ENABLED=true
CANOPY_METRICS_ENABLED=true

# Grafana admin credentials
GRAFANA_ADMIN_USER=admin
# Note: GRAFANA_ADMIN_PASSWORD is not used by docker-compose.yml.
# The password is supplied via Docker secret (GF_SECURITY_ADMIN_PASSWORD__FILE).
# Set it in secrets/grafana_admin_password.txt instead.
