# =============================================================================
# Juniper Deploy — Observability Profile Overrides
#
# Source this file when running with the observability profile:
#   docker compose --env-file .env.observability \
#     --profile full --profile observability up -d
#
# Or use the Makefile shortcut:
#   make monitor    # full + observability  (aliased as `make obs`)
#
# Note: `make obs-demo` is intentionally NOT provided — under the `demo`
# profile cascor/canopy compose service names get a `-demo` suffix and
# break the prometheus.yml scrape targets. A real demo-aware observability
# entry point would need a demo-specific scrape file; tracked as the
# deferred follow-up in
# notes/poc/POC_REMEDIATION_PLAN_2026-05-27.md §6.
# =============================================================================

# Enable Prometheus /metrics endpoint on all services
JUNIPER_DATA_METRICS_ENABLED=true
JUNIPER_CASCOR_METRICS_ENABLED=true
CANOPY_METRICS_ENABLED=true

# SEC-16 / POC remediation §2.2 (juniper-data#157) + §3.1 (juniper-cascor#313)
# + §6 (juniper-canopy#331 — `MetricsAuthMiddleware` promoted to
# `juniper-observability` 0.3.0 in juniper-ml#335):
# Allow Prometheus to scrape ``/metrics`` from juniper-data, juniper-cascor,
# AND juniper-canopy through their respective ``MetricsAuthMiddleware`` IP
# allowlists. The defaults in docker-compose.yml are loopback-only
# (``["127.0.0.1","::1"]``); in compose Prometheus lives on the Docker
# bridge networks below, so we widen the allowlist to cover those subnets.
# CIDR support (no need to enumerate per-container IPs that drift across
# ``down/up`` cycles) shipped in juniper-data #157 / juniper-cascor #313 /
# juniper-canopy #331; IPv4-mapped IPv6 client addresses are unwrapped
# before membership check so a container appearing as
# ``::ffff:172.18.0.5`` matches the IPv4 ``172.18.0.0/16`` entry. To add
# extra prometheus hosts (out-of-compose scrapers, sidecar nodes, etc),
# add more entries to the JSON list; entries can be bare IPs OR CIDRs.
# Subnets enumerated below match the four compose networks declared at the
# bottom of docker-compose.yml: backend / data / frontend / monitoring.
JUNIPER_DATA_METRICS_TRUSTED_IPS=["172.18.0.0/16","172.19.0.0/16","172.20.0.0/16","172.21.0.0/16","127.0.0.1","::1"]
JUNIPER_CASCOR_METRICS_TRUSTED_IPS=["172.18.0.0/16","172.19.0.0/16","172.20.0.0/16","172.21.0.0/16","127.0.0.1","::1"]
JUNIPER_CANOPY_METRICS_TRUSTED_IPS=["172.18.0.0/16","172.19.0.0/16","172.20.0.0/16","172.21.0.0/16","127.0.0.1","::1"]

# Grafana admin credentials are managed via the Docker secret
# (GF_SECURITY_ADMIN_PASSWORD__FILE) populated from
# secrets/grafana_admin_password.txt. The username defaults to "admin" in
# docker-compose.yml; override GRAFANA_ADMIN_USER there if needed.
