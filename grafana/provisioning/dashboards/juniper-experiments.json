    {
      "id": 13,
      "type": "timeseries",
      "title": "Training Step Duration \u2014 p50 / p95",
      "description": "Quantiles of juniper_cascor_training_step_duration_seconds, grouped by run_id so concurrent runs never blend. The family carries no phase label (dropped in OBS-WIRE-01 A.6). SLO 3.4 targets p95 < 5s.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 31
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le, run_id) (rate(juniper_cascor_training_step_duration_seconds_bucket{environment=\"host-experiment\", run_id=~\"$run_id\", service=~\"$service\"}[$interval])))",
          "legendFormat": "{{run_id}} p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le, run_id) (rate(juniper_cascor_training_step_duration_seconds_bucket{environment=\"host-experiment\", run_id=~\"$run_id\", service=~\"$service\"}[$interval])))",
          "legendFormat": "{{run_id}} p95"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 5
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          }
        }
