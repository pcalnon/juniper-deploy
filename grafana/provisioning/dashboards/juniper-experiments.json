      "type": "timeseries",
      "title": "Request Rate",
      "description": "Per-second HTTP request rate across every host-experiment target. Matched by __name__ regex rather than a fixed per-service prefix: cascor and data namespace their families (juniper_cascor_http_*, juniper_data_http_*) but recurrence adds PrometheusMiddleware without a namespace kwarg, so its families are the un-prefixed juniper_http_*. The regex covers all three; the environment matcher keeps it scoped to experiment runs.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 57
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (run_id, service) (rate({__name__=~\"juniper.*_http_requests_total\", environment=\"host-experiment\", run_id=~\"$run_id\", service=~\"$service\"}[$interval]))",
          "legendFormat": "{{run_id}} \u2014 {{service}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 10
          }
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
