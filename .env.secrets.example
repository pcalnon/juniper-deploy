# =============================================================================
# Juniper Deploy — Secret Environment Variables
# Copy this file to .env.secrets and fill in your values:
#   cp .env.secrets.example .env.secrets
#
# Then encrypt with SOPS:
#   sops -e --input-type dotenv --output-type dotenv .env.secrets > .env.secrets.enc
# =============================================================================

# API Security Keys
JUNIPER_DATA_API_KEYS=
JUNIPER_CASCOR_API_KEYS=
CANOPY_API_KEY=
