# =============================================================================
# Juniper Deploy — Secret Environment Variables
# Copy this file to .env.secrets and fill in your values:
#   cp .env.secrets.example .env.secrets
#
# Then encrypt with SOPS:
#   sops -e --input-type dotenv --output-type dotenv .env.secrets > .env.secrets.enc
# =============================================================================

# API Security Keys
JUNIPER_DATA_API_KEYS=
JUNIPER_CASCOR_API_KEYS=
CANOPY_API_KEY=

# Worker → cascor WebSocket authentication.
# CASCOR_AUTH_TOKEN is the single token each juniper-cascor-worker sends as the
# X-API-Key header on its /ws/v1/workers connection. It MUST appear in the
# JUNIPER_CASCOR_API_KEYS list above (cascor validates against the set). The
# simplest rotation: set CASCOR_AUTH_TOKEN and JUNIPER_CASCOR_API_KEYS to the
# same random value (e.g., `python -c 'import secrets; print(secrets.token_urlsafe(32))'`).
# `make prepare-secrets` then writes both into ./secrets/cascor_auth_token.txt
# and ./secrets/juniper_cascor_api_keys.txt automatically.
CASCOR_AUTH_TOKEN=

# Canopy → cascor outbound API key (the single key canopy sends when calling
# cascor REST endpoints). Like CASCOR_AUTH_TOKEN, this value must be in the
# JUNIPER_CASCOR_API_KEYS list. Typically set to the same value as
# CASCOR_AUTH_TOKEN to keep rotation single-handed.
JUNIPER_CASCOR_API_KEY=

# Grafana admin password.
# Mounted into the grafana container via the `grafana_admin_password`
# Docker secret, sourced by ${GRAFANA_ADMIN_PASSWORD_FILE} (default:
# ./secrets/grafana_admin_password.txt — gitignored).  This entry in
# .env.secrets.enc is the canonical secret-of-record for backup and
# rotation; docker-compose does NOT read GRAFANA_ADMIN_PASSWORD itself
# (the file mount is the runtime source).  To rotate: decrypt this
# file, set a new value, re-encrypt, and mirror the new value into
# ${GRAFANA_ADMIN_PASSWORD_FILE}.
GRAFANA_ADMIN_PASSWORD=

# Alertmanager SMTP credentials (OBS-ROUTE-01).
# Alertmanager does NOT natively substitute env vars in YAML — these
# values are not consumed by docker-compose.  They exist here so the
# encrypted .env.secrets.enc carries the canonical secret-of-record.
# At runtime the password is mounted into the alertmanager container
# via the `alertmanager_smtp_password` Docker secret, sourced by
# ${ALERTMANAGER_SMTP_PASSWORD_FILE} (default:
# ./secrets.example/alertmanager_smtp_password.txt — placeholder).
# To rotate: decrypt, edit, re-encrypt, then mirror the new password
# into ${ALERTMANAGER_SMTP_PASSWORD_FILE}.  See
# notes/ALERTMANAGER_NOTIFICATION_RUNBOOK.md for the full procedure.
ALERTMANAGER_SMTP_USER=
ALERTMANAGER_SMTP_PASSWORD=
SMTP_FROM_DOMAIN=
TICKET_ALERT_RECIPIENT_EMAIL=
CRITICAL_ALERT_RECIPIENT_EMAIL=
DEFAULT_ALERT_RECIPIENT_EMAIL=
