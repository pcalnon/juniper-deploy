# =============================================================================
# Juniper Deploy — Environment Variables
# Copy this file to .env and customize as needed.
# All values use ${VAR:-default} substitution in docker-compose.yml.
# =============================================================================

# === Host port binding (DEPLOY-08) ===
# Controls the host-side bind address for every published port.
# Defaults to 127.0.0.1 (loopback only) for safety. Set to 0.0.0.0 to expose
# services on all host interfaces.
# BIND_HOST=127.0.0.1

# === Resource limits (DEPLOY-07) ===
# Compose v2 honours `deploy.resources.limits` via cgroups. Three tiers cover
# the workload mix; bump down to enforce tighter limits, bump up if your
# cascor training jobs need more headroom. Values feed YAML anchors in
# docker-compose.yml.
# RESOURCES_HEAVY_CPUS=4.0
# RESOURCES_HEAVY_MEMORY=8G
# RESOURCES_HEAVY_CPUS_RESERVATION=1.0
# RESOURCES_HEAVY_MEMORY_RESERVATION=2G
# RESOURCES_LIGHT_CPUS=1.0
# RESOURCES_LIGHT_MEMORY=2G
# RESOURCES_LIGHT_CPUS_RESERVATION=0.25
# RESOURCES_LIGHT_MEMORY_RESERVATION=256M
# RESOURCES_TINY_CPUS=0.5
# RESOURCES_TINY_MEMORY=256M
# RESOURCES_TINY_CPUS_RESERVATION=0.1
# RESOURCES_TINY_MEMORY_RESERVATION=64M

# === JuniperData ===
JUNIPER_DATA_HOST=0.0.0.0
JUNIPER_DATA_PORT=8100
JUNIPER_DATA_LOG_LEVEL=INFO
# JUNIPER_DATA_STORAGE_PATH=/app/data/datasets

# === JuniperCascor ===
CASCOR_HOST=0.0.0.0
CASCOR_PORT=8200
# CASCOR_HOST_PORT=8201  # Host-exposed port (default: 8201 to avoid conflicts; set to 8200 if available)
CASCOR_LOG_LEVEL=INFO

# === juniper-canopy (uses JUNIPER_CANOPY_* prefix) ===
CANOPY_HOST=0.0.0.0
CANOPY_PORT=8050
# JUNIPER_CANOPY_DEMO_MODE=true  # Uncomment for demo mode (no real CasCor backend needed)

# === Inter-service URLs ===
# Docker internal DNS — override only for custom networking or native execution.
JUNIPER_DATA_URL=http://juniper-data:8100
CASCOR_SERVICE_URL=http://juniper-cascor:8200

# === API Security (Optional — disabled when unset) ===
# Uncomment and set keys to enable API authentication per service.
# When unset, all endpoints are open (development mode).
# JUNIPER_DATA_API_KEYS=your-data-api-key
# JUNIPER_CASCOR_API_KEYS=your-cascor-api-key
# CANOPY_API_KEY=your-canopy-api-key
# JUNIPER_CASCOR_RATE_LIMIT_ENABLED=false
# JUNIPER_CASCOR_RATE_LIMIT_REQUESTS_PER_MINUTE=60
# JUNIPER_CANOPY_RATE_LIMIT_ENABLED=false
# JUNIPER_CANOPY_RATE_LIMIT_REQUESTS_PER_MINUTE=60

# === Redis (Optional — used by juniper-canopy caching) ===
# REDIS_PORT=6379
# REDIS_MAX_MEMORY=100mb
# REDIS_URL=redis://redis:6379/0  # Set on canopy service automatically in full profile

# === Cassandra (Optional — used by juniper-canopy metrics store) ===
# CASSANDRA_PORT=9042
# CASSANDRA_MAX_HEAP=512M
# CASSANDRA_HEAP_NEW=128M

# === Observability (Optional — disabled by default) ===
# Set log format to "json" for structured JSON logging.
# JUNIPER_DATA_LOG_FORMAT=text
# JUNIPER_CASCOR_LOG_FORMAT=text
# JUNIPER_CANOPY_LOG_FORMAT=text

# Sentry DSN for error tracking. Leave empty to disable.
# JUNIPER_DATA_SENTRY_DSN=
# JUNIPER_CASCOR_SENTRY_DSN=
# JUNIPER_CANOPY_SENTRY_DSN=

# Enable Prometheus metrics endpoint on each service (/metrics).
# JUNIPER_DATA_METRICS_ENABLED=false
# JUNIPER_CASCOR_METRICS_ENABLED=false
# JUNIPER_CANOPY_METRICS_ENABLED=false

# SEC-16: trusted-IP allowlist for juniper-data's /metrics endpoint.
# JSON list of IP literals or CIDR ranges. Defaults to loopback only.
# Pre-CIDR-support (juniper-data <= 0.6.x), exact string match only — list
# the prometheus container's docker-network IPs explicitly. Post-CIDR-support
# (juniper-data PR for Issue 4 in notes/poc/POC_REMEDIATION_PLAN_2026-05-27.md),
# CIDR ranges like `172.18.0.0/16` are honored.
# JUNIPER_DATA_METRICS_TRUSTED_IPS=["127.0.0.1","::1","172.18.0.0/16"]

# Grafana admin username (used by observability profile).
# GRAFANA_ADMIN_USER=admin
# Grafana admin password is managed via Docker secrets (secrets/grafana_admin_password.txt).

# Tip: Use .env.observability to auto-enable metrics when running with
# --profile observability. See 'make obs' and 'make obs-demo'.

# =============================================================================
# === Health Check Defaults ===
# These variables drive the x-healthcheck-defaults Compose extension fields.
# Defaults match the previously hardcoded values, so leaving them unset
# preserves current behavior.
# =============================================================================
# General service health checks (juniper-data, juniper-cascor, juniper-canopy)
# HEALTHCHECK_INTERVAL=15s
# HEALTHCHECK_TIMEOUT=10s
# HEALTHCHECK_RETRIES=5
# HEALTHCHECK_START_PERIOD=10s
# HEALTHCHECK_START_PERIOD_CASCOR=15s
# HEALTHCHECK_START_PERIOD_CANOPY=20s

# Worker (juniper-cascor-worker) — slower interval, fewer retries
# HEALTHCHECK_WORKER_INTERVAL=30s
# HEALTHCHECK_WORKER_TIMEOUT=10s
# HEALTHCHECK_WORKER_START_PERIOD=15s
# HEALTHCHECK_WORKER_RETRIES=3

# Redis — faster interval since restart is cheap
# HEALTHCHECK_REDIS_INTERVAL=10s
# HEALTHCHECK_REDIS_TIMEOUT=5s
# HEALTHCHECK_REDIS_START_PERIOD=5s
# HEALTHCHECK_REDIS_RETRIES=5

# =============================================================================
# === Prometheus Configuration ===
# Prometheus YAML files do not natively support env interpolation. These
# values document the hardcoded defaults in prometheus/prometheus.yml so they
# can be templated via envsubst in deployment pipelines if desired.
# =============================================================================
# PROMETHEUS_SCRAPE_INTERVAL=15s
# PROMETHEUS_EVAL_INTERVAL=15s
# PROMETHEUS_SCRAPE_TIMEOUT=10s
# PROMETHEUS_RETENTION=30d
# PROMETHEUS_DATA_SCRAPE_INTERVAL=10s
# PROMETHEUS_CASCOR_SCRAPE_INTERVAL=10s
# PROMETHEUS_CANOPY_SCRAPE_INTERVAL=15s
# ALERTMANAGER_TARGET=alertmanager:9093

# =============================================================================
# === AlertManager Configuration ===
# Host port published by the alertmanager service (observability profile).
# Container port is fixed at 9093 (the upstream prom/alertmanager default).
# =============================================================================
# ALERTMANAGER_PORT=9093

# =============================================================================
# === Grafana Configuration ===
# =============================================================================
# GRAFANA_ALLOW_SIGNUP=false
# GRAFANA_PROMETHEUS_URL=http://prometheus:9090
# GRAFANA_MIN_INTERVAL=10s
# GRAFANA_HOME_DASHBOARD=/etc/grafana/provisioning/dashboards/juniper-overview.json

# =============================================================================
# === Worker Replicas (juniper-cascor-worker) ===
# =============================================================================
# WORKER_REPLICAS=2
